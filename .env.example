DATABASE_URL="sqlserver://localhost:1433;database=MortgageMarketingPrototype;user=mortgage_app;password={REPLACE_WITH_A_STRONG_APP_PASSWORD};encrypt=true;trustServerCertificate=true;schema=dbo"

DB_HOST="localhost"
DB_PORT="1433"
DB_NAME="MortgageMarketingPrototype"

# Privileged SQL Server login used only by `npm run setup` / `db:bootstrap`.
# It must be able to create a database and create or alter SQL logins.
DB_ADMIN_USER="YOUR_SQL_ADMIN_USER"
DB_ADMIN_PASSWORD="REPLACE_WITH_SQL_ADMIN_PASSWORD"

# Dedicated SQL login used by Prisma and the web application.
DB_USER="mortgage_app"

# IMPORTANT: Replace this before running setup. Use the same password in the
# DATABASE_URL above when running Prisma commands directly.
DB_PASSWORD="REPLACE_WITH_A_STRONG_APP_PASSWORD"

# Server-only key for public YouTube Data API v3 requests.
YOUTUBE_API_KEY="replace-with-your-local-youtube-data-api-key"
